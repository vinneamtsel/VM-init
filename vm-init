#!/usr/bin/env bash
#
# vm-init - one-shot initial setup for a freshly cloned Ubuntu 24.04 VM.
#
# Usage:
#   sudo vm-init
#
# Two phases:
#   1. Collect: asks every question up front. Nothing is changed.
#   2. Execute: shows the full plan, and after your confirmation applies
#      everything in one pass.
#
# Safe to re-run. Steps that are already done are skipped or idempotent.
#
set -euo pipefail

GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; CYAN=$'\033[36m'; BOLD=$'\033[1m'; NC=$'\033[0m'

info() { printf '%s[*]%s %s\n' "$GREEN" "$NC" "$*"; }
ok()   { printf '%s[+]%s %s\n' "$GREEN" "$NC" "$*"; }
warn() { printf '%s[!]%s %s\n' "$YELLOW" "$NC" "$*"; }
err()  { printf '%s[x]%s %s\n' "$RED" "$NC" "$*" >&2; }
die()  { err "$*"; exit 1; }

# ask QUESTION DEFAULT -> echoes the answer (DEFAULT on plain Enter)
ask() {
  local q="$1" d="${2:-}" ans
  if [[ -n $d ]]; then
    read -r -p "$q [$d]: " ans || { echo; die "Input cancelled, no changes were made."; }
    echo "${ans:-$d}"
  else
    read -r -p "$q: " ans || { echo; die "Input cancelled, no changes were made."; }
    echo "$ans"
  fi
}

# ask_secret QUESTION -> echoes the password (hidden input, typed twice)
ask_secret() {
  local q="$1" a b
  read -r -s -p "$q: " a || { echo; die "Input cancelled, no changes were made."; }
  echo
  read -r -s -p "Repeat $q: " b || { echo; die "Input cancelled, no changes were made."; }
  echo
  [[ -n $a ]] || die "Password cannot be empty."
  [[ $a == "$b" ]] || die "Passwords do not match."
  echo "$a"
}

# confirm QUESTION DEFAULT_IS_YES -> 0 for yes, 1 for no
confirm() {
  local q="$1" d="${2:-y}" ans
  read -r -p "$q [$([ "$d" = y ] && echo Y/n || echo y/N)]: " ans || { echo; die "Input cancelled, no changes were made."; }
  case "${ans,,}" in
    y|yes) return 0 ;;
    n|no)  return 1 ;;
    *)     [[ $d == y ]] ;;
  esac
}

STEP="startup"
trap 'err "vm-init failed during: ${STEP:-unknown} (line $LINENO: $BASH_COMMAND)"' ERR

banner() {
  local i
  printf '%s\n' "$CYAN╔$(printf '═%.0s' {1..58})╗$NC"
  for i in "  VM-INIT   one-shot setup for a cloned Ubuntu 24.04 VM" \
           "  phase 1: answer the questions (nothing is changed yet)" \
           "  phase 2: review the plan, then confirm to execute"; do
    printf '%s%-58s%s\n' "$CYAN║" "$i" "$CYAN║$NC"
  done
  printf '%s\n' "$CYAN╚$(printf '═%.0s' {1..58})╝$NC"
}

# ---- optional software --------------------------------------------------

install_docker() {
  command -v docker >/dev/null 2>&1 && { ok "Docker already installed"; return; }
  info "Installing Docker via https://get.docker.com ..."
  curl -fsSL https://get.docker.com | sh
  for u in "${SUDO_USER:-}" "$ADMIN_USER"; do
    [[ -n $u && $u != root ]] && usermod -aG docker "$u"
  done
  ok "Docker installed (docker group: ${SUDO_USER:-} ${ADMIN_USER:-})"
}

install_node() {
  command -v node >/dev/null 2>&1 && { ok "Node already installed"; return; }
  info "Installing nvm and Node LTS ..."
  export NVM_DIR=/root/.nvm
  curl -fsSL -o /tmp/nvm-install.sh \
    https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh
  bash /tmp/nvm-install.sh
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
  nvm install --lts
  nvm alias default 'lts/*'
  nvm use default
  # system-wide symlinks so every user gets node/npm/npx
  local node_bin
  node_bin="$NVM_DIR/current/bin"
  [[ -d $node_bin ]] || node_bin=$(dirname "$(nvm which default)")
  if compgen -G "$node_bin"/* >/dev/null; then
    ln -sf "$node_bin"/* /usr/local/bin/
  fi
  ok "Node $(node -v) installed via nvm (default: lts/*, nvm itself is root-only)"
}

apt_install() {
  if DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$1" >/dev/null; then
    ok "$1 installed"
  else
    warn "Failed to install $1"
  fi
}

wait_for_apt() {
  command -v fuser >/dev/null 2>&1 || return 0
  local i
  for i in $(seq 1 60); do
    fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock >/dev/null 2>&1 || return 0
    sleep 2
  done
  die "apt is locked by another process (waited 120s)"
}

# ---- phase 1: collect answers (no changes) ------------------------------

collect() {
  echo; info "== Question 1/9: Identity =="
  CURRENT_HOST=$(hostname)
  HOSTNAME_NEW=$(ask "New hostname" "$CURRENT_HOST")
  ROTATE=0
  if [[ $HOSTNAME_NEW != "$CURRENT_HOST" ]]; then
    ROTATE=1
  else
    confirm "Regenerate machine-id and SSH host keys" n && ROTATE=1
  fi

  echo; info "== Question 2/9: Network =="
  IFACE=$(ip route get 8.8.8.8 2>/dev/null | awk '{print $5; exit}' || true)
  [[ -z $IFACE ]] && IFACE=$(ls /sys/class/net | grep -v '^lo$' | head -1 || true)
  [[ -z $IFACE ]] && die "No network interface found."
  info "Interface: $IFACE  current: $(ip -4 -o addr show "$IFACE" | awk '{print $4; exit}')"
  NET_MODE=dhcp
  if confirm "Use a static IP instead of DHCP" y; then
    NET_MODE=static
    STATIC_IP=$(ask "Static IP/CIDR (e.g. 10.0.0.11/24)" "")
    while [[ ! $STATIC_IP =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]]; do
      warn "Invalid format, use IP/CIDR like 10.0.0.11/24"
      STATIC_IP=$(ask "Static IP/CIDR" "")
    done
    GATEWAY=$(ask "Gateway" "$(ip route | awk '/default/ {print $3; exit}')")
    while [[ ! $GATEWAY =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; do
      warn "Invalid gateway address"
      GATEWAY=$(ask "Gateway" "")
    done
    DNS_LIST=$(ask "DNS servers (comma or space separated)" "1.1.1.1, 8.8.8.8")
    SEARCH_DOMAIN=$(ask "Search domain(s) (optional)" "")
    DNS_LIST=$(printf '%s' "$DNS_LIST" | tr -s ' ,' ',' | sed 's/^,\|,$//g')
    [[ -n $SEARCH_DOMAIN ]] && SEARCH_DOMAIN=$(printf '%s' "$SEARCH_DOMAIN" | tr -s ' ,' ',' | sed 's/^,\|,$//g')
  fi

  echo; info "== Question 3/9: Time =="
  TIMEZONE=$(ask "Timezone" "$(timedatectl show -p Timezone --value)")

  echo; info "== Question 4/9: Security =="
  CREATE_ADMIN=n
  ADMIN_USER=
  ADMIN_PASS=
  if confirm "Create a new admin user (sudo)" y; then
    CREATE_ADMIN=y
    ADMIN_USER=$(ask "Username" "admin")
    ADMIN_PASS=$(ask_secret "Password for $ADMIN_USER")
  fi
  KEEP_PASSWORD=y
  confirm "Keep SSH password authentication enabled" y || KEEP_PASSWORD=n
  DISABLE_ROOT=y
  confirm "Disable root SSH login" y || DISABLE_ROOT=n
  UFW_ENABLE=n
  EXTRA_PORTS=
  if confirm "Enable firewall (ufw, default deny incoming)" y; then
    UFW_ENABLE=y
    EXTRA_PORTS=$(ask "Extra ports to allow (SSH is always open, e.g. 80,443)" "80,443")
  fi

  echo; info "== Question 5/9: Software =="
  echo "  1) Docker CE + Compose (get.docker.com)"
  echo "  2) Node.js LTS via nvm"
  echo "  3) Nginx (apt)"
  echo "  4) python3-pip (apt)"
  echo "  5) PostgreSQL (apt)"
  OPT_SEL=$(ask "Optional software (comma separated numbers)" "0")
  OPT_SEL=$(printf '%s' "$OPT_SEL" | tr -d ' ' | sed 's/^0,//; s/,0,/,/; s/,0$//')

  echo; info "== Question 6/9: Swap =="
  SWAP_ENABLE=n
  SWAP_SIZE=2G
  if confirm "Create a swapfile if none exists (recommended for small VMs)" n; then
    SWAP_ENABLE=y
    SWAP_SIZE=$(ask "Swap size" "2G")
  fi

  echo; info "== Question 7/9: Disk resize =="
  RESIZE_ENABLE=y
  confirm "Grow partition/filesystem if the disk is larger" y || RESIZE_ENABLE=n

  echo; info "== Question 8/9: Cleanup =="
  PURGE_CI=y
  confirm "Remove cloud-init (you don't use it)" y || PURGE_CI=n

  echo; info "== Question 9/9: Reboot =="
  REBOOT_NOW=y
  confirm "Reboot after everything is applied" y || REBOOT_NOW=n

  ok "All answers collected. Review the plan below."
}

# ---- plan review --------------------------------------------------------

show_plan() {
  local rot_s swap_s resize_s cleanup_s reboot_s sec pkgs
  echo
  printf '%s=== Plan ===%s\n' "$BOLD" "$NC"
  if [[ $ROTATE -eq 1 ]]; then rot_s="rotate machine-id/SSH keys"; else rot_s="keep machine-id/SSH keys"; fi
  printf '%-11s %s\n' "Identity" "hostname -> $HOSTNAME_NEW | $rot_s"
  if [[ $NET_MODE == static ]]; then
    printf '%-11s %s\n' "Network" "static $STATIC_IP | gw $GATEWAY | dns $DNS_LIST${SEARCH_DOMAIN:+ | search $SEARCH_DOMAIN}"
  else
    printf '%-11s %s\n' "Network" "DHCP (reserve by MAC in your router)"
  fi
  printf '%-11s %s\n' "Time" "$TIMEZONE | NTP on"
  if [[ $CREATE_ADMIN == y ]]; then sec="admin user: $ADMIN_USER (sudo)"; else sec="no admin user"; fi
  [[ $KEEP_PASSWORD == y ]] && sec+=" | password auth: keep" || sec+=" | password auth: disable"
  [[ $DISABLE_ROOT == y ]] && sec+=" | root login: disabled" || sec+=" | root login: enabled"
  if [[ $UFW_ENABLE == y ]]; then
    sec+=" | ufw: on${EXTRA_PORTS:+, allow $EXTRA_PORTS}"
  else
    sec+=" | ufw: off"
  fi
  sec+=" | fail2ban + unattended-upgrades"
  printf '%-11s %s\n' "Security" "$sec"
  pkgs="full apt upgrade + base tools + herdr"
  [[ $OPT_SEL != 0 && -n $OPT_SEL ]] && pkgs+=" | optional: $OPT_SEL"
  printf '%-11s %s\n' "Packages" "$pkgs"
  printf '%-11s %s\n' "MOTD" "login banner + colored bash prompt"
  if [[ $SWAP_ENABLE == y ]]; then swap_s="create $SWAP_SIZE swapfile if none exists"; else swap_s="none"; fi
  printf '%-11s %s\n' "Swap" "$swap_s"
  if [[ $RESIZE_ENABLE == y ]]; then resize_s="grow disk if larger"; else resize_s="skip"; fi
  printf '%-11s %s\n' "Resize" "$resize_s"
  if [[ $PURGE_CI == y ]]; then cleanup_s="purge cloud-init"; else cleanup_s="keep cloud-init"; fi
  cleanup_s+=" + autoremove + vacuum logs"
  printf '%-11s %s\n' "Cleanup" "$cleanup_s"
  if [[ $REBOOT_NOW == y ]]; then reboot_s="at the end"; else reboot_s="manual"; fi
  printf '%-11s %s\n' "Reboot" "$reboot_s"
  echo
  warn "Nothing has been changed yet. Aborting here leaves the VM untouched."
}

# ---- phase 2: execute (no prompts) --------------------------------------

execute() {
  export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a APT_LISTCHANGES_FRONTEND=none
  # stop apt daily timers so they don't grab the dpkg lock while we upgrade
  systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true

  # ---- 1/9 identity ----
  STEP="identity"
  echo; info "=== 1/9 Identity ==="
  if [[ $HOSTNAME_NEW != "$CURRENT_HOST" ]]; then
    hostnamectl set-hostname "$HOSTNAME_NEW"
    sed -i '/127.0.1.1/d' /etc/hosts
    echo "127.0.1.1 $HOSTNAME_NEW" >> /etc/hosts
    ok "Hostname set to $HOSTNAME_NEW"
  fi
  if [[ $ROTATE -eq 1 ]]; then
    rm -f /etc/machine-id /var/lib/dbus/machine-id
    systemd-machine-id-setup >/dev/null 2>&1 || die "machine-id regeneration failed"
    rm -f /etc/ssh/ssh_host_*
    ssh-keygen -A >/dev/null 2>&1 || die "SSH host key regeneration failed"
    ok "machine-id and SSH host keys regenerated"
  fi

  # ---- 2/9 network ----
  STEP="network"
  echo; info "=== 2/9 Network ==="
  local renderer
  if systemctl is-active --quiet NetworkManager; then renderer=NetworkManager; else renderer=networkd; fi
  rm -f /etc/netplan/50-cloud-init.yaml
  {
    echo "network:"
    echo "  version: 2"
    echo "  renderer: $renderer"
    echo "  ethernets:"
    echo "    $IFACE:"
    if [[ $NET_MODE == static ]]; then
      echo "      dhcp4: false"
      echo "      dhcp6: false"
      echo "      addresses:"
      echo "        - $STATIC_IP"
      echo "      routes:"
      echo "        - to: default"
      echo "          via: $GATEWAY"
      echo "      nameservers:"
      echo "        addresses: [${DNS_LIST// /}]"
      if [[ -n $SEARCH_DOMAIN ]]; then
        echo "        search: [$SEARCH_DOMAIN]"
      fi
    else
      echo "      dhcp4: true"
      echo "      dhcp6: false"
      if [[ $renderer == networkd ]]; then
        echo "      dhcp-identifier: mac"
      fi
    fi
  } > /etc/netplan/99-vm-init.yaml
  chmod 600 /etc/netplan/99-vm-init.yaml
  netplan generate || die "Invalid netplan config in /etc/netplan/99-vm-init.yaml. Re-run to fix."
  ok "Netplan written and validated (applied at the end)"

  # ---- 3/9 time ----
  STEP="time"
  echo; info "=== 3/9 Time ==="
  timedatectl set-timezone "$TIMEZONE"
  timedatectl set-ntp true
  ok "Timezone $TIMEZONE, NTP enabled (systemd-timesyncd)"

  # ---- 4/9 security ----
  STEP="security"
  echo; info "=== 4/9 Security ==="
  if [[ $CREATE_ADMIN == y ]]; then
    if ! id "$ADMIN_USER" >/dev/null 2>&1; then
      useradd -m -s /bin/bash "$ADMIN_USER"
    fi
    echo "$ADMIN_USER:$ADMIN_PASS" | chpasswd
    usermod -aG sudo "$ADMIN_USER"
    ok "User $ADMIN_USER created and added to sudo"
  fi

  local ssh_opts=()
  if [[ $KEEP_PASSWORD == n ]]; then ssh_opts+=("PasswordAuthentication no"); fi
  if [[ $DISABLE_ROOT == y ]]; then ssh_opts+=("PermitRootLogin no"); fi
  if [[ ${#ssh_opts[@]} -gt 0 ]]; then
    # 00- sorts before cloud-init's 50- drop-in; sshd keeps the first value
    printf '%s\n' "${ssh_opts[@]}" > /etc/ssh/sshd_config.d/00-vm-init.conf
    rm -f /etc/ssh/sshd_config.d/99-vm-init.conf
    systemctl restart ssh
    ok "SSH hardened: ${ssh_opts[*]}"
  else
    rm -f /etc/ssh/sshd_config.d/00-vm-init.conf /etc/ssh/sshd_config.d/99-vm-init.conf
    systemctl restart ssh
  fi

  if [[ $UFW_ENABLE == y ]]; then
    local port p allow
    port=$(sshd -T 2>/dev/null | awk '/^port /{print $2}' || echo 22)
    port=${port:-22}
    command -v ufw >/dev/null 2>&1 || apt-get install -y -q ufw >/dev/null
    ufw allow "$port/tcp" >/dev/null
    allow=("$port/tcp")
    IFS=',' read -ra extra_ports <<< "$EXTRA_PORTS"
    for p in "${extra_ports[@]}"; do
      p=${p// /}
      if [[ -n $p && $p != "$port" ]]; then
        if ufw allow "$p" >/dev/null; then
          allow+=("$p")
        else
          warn "ufw could not allow $p"
        fi
      fi
    done
    ufw --force enable >/dev/null
    ok "ufw enabled (allowed: $(IFS=,; printf '%s' "${allow[*]}"))"
  fi

  info "Installing fail2ban and unattended-upgrades ..."
  wait_for_apt
  DEBIAN_FRONTEND=noninteractive apt-get install -y -q fail2ban unattended-upgrades >/dev/null
  systemctl enable --now fail2ban >/dev/null 2>&1 || true
  ok "fail2ban enabled (unattended-upgrades is armed after the full upgrade)"

  # ---- 5/9 packages ----
  STEP="packages"
  echo; info "=== 5/9 System update and software ==="
  info "Running apt update + full upgrade (this can take a while) ..."
  wait_for_apt
  apt-get update -q
  wait_for_apt
  apt-get upgrade -y -q
  apt-get install -y -q \
    curl wget git vim htop unzip jq rsync net-tools \
    ca-certificates gnupg software-properties-common
  ok "Base tools installed"

  info "Installing herdr (terminal multiplexer, https://herdr.dev) ..."
  if ! command -v herdr >/dev/null 2>&1; then
    export HERDR_INSTALL_DIR=/usr/local/bin
    curl -fsSL https://herdr.dev/install.sh | sh
  fi
  ok "herdr installed (system-wide at /usr/local/bin/herdr)"

  if [[ $OPT_SEL != 0 && -n $OPT_SEL ]]; then
    local n
    IFS=',' read -ra sels <<< "$OPT_SEL"
    for n in "${sels[@]}"; do
      n=${n// /}
      case "$n" in
        1) install_docker || warn "Docker install failed" ;;
        2) install_node || warn "Node install failed" ;;
        3) apt_install nginx ;;
        4) apt_install python3-pip ;;
        5) apt_install postgresql ;;
        *) warn "Unknown selection: $n" ;;
      esac
    done
  fi

  # ---- 6/9 MOTD ----
  STEP="motd"
  echo; info "=== 6/9 MOTD / welcome message ==="
  cat > /etc/update-motd.d/99-vm-info <<'EOF'
#!/bin/sh
printf '\033[1;32mWelcome to %s\033[0m\n' "$(hostname)"
echo '-------------------------------------------'
echo "IP:      $(hostname -I 2>/dev/null | awk '{print $1}')"
. /etc/os-release
echo "OS:      $PRETTY_NAME"
echo "Kernel:  $(uname -r)"
echo "Uptime:  $(uptime -p | sed 's/up //')"
df -h / | awk 'NR==2 {printf "Disk:    %s used of %s (%s)\n", $3, $2, $5}'
free -h | awk 'NR==2 {printf "Memory:  %s used of %s\n", $3, $2}'
updates=$(apt list --upgradable 2>/dev/null | wc -l)
if [ "${updates:-0}" -gt 1 ] 2>/dev/null; then
  echo "Updates: $((updates - 1)) pending (sudo apt upgrade)"
fi
EOF
  chmod +x /etc/update-motd.d/99-vm-info
  [[ -f /etc/default/motd-news ]] && sed -i 's/^ENABLED=.*/ENABLED=0/' /etc/default/motd-news

  # colored two-line bash prompt: ╭── user@host ~/dir (branch) [exit N] / ╰─❯
  if ! grep -q '_vm_init_prompt' /etc/bash.bashrc 2>/dev/null; then
    cat >> /etc/bash.bashrc <<'EOF'

# vm-init: two-line prompt with git branch and exit status
_vm_init_prompt() {
  local last=$?
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  [[ -n $branch ]] && branch=" \[\e[33m\]($branch)\[\e[0m\]"
  PS1="\[\e[36m\]╭──\[\e[0m\] \[\e[32m\]\u@\h\[\e[0m\] \[\e[34m\]\w\[\e[0m\]$branch"
  if [[ $last -ne 0 ]]; then
    PS1+=" \[\e[31m\][exit $last]\[\e[0m\]"
  fi
  PS1+=$'\n\[\e[36m\]╰─❯\[\e[0m\] '
}
PROMPT_COMMAND=_vm_init_prompt
EOF
  fi
  ok "MOTD and bash prompt installed"

  # ---- 7/9 swap ----
  STEP="swap"
  echo; info "=== 7/9 Swap ==="
  if swapon --show | grep -q .; then
    swapon --show | awk 'NR==1 || NR==2 {print}'
    info "Swap already present, skipping"
  elif [[ $SWAP_ENABLE == y ]]; then
    fallocate -l "$SWAP_SIZE" /swapfile
    chmod 600 /swapfile
    mkswap /swapfile >/dev/null
    swapon /swapfile
    grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    echo 'vm.swappiness=10' > /etc/sysctl.d/99-swappiness.conf
    sysctl -p /etc/sysctl.d/99-swappiness.conf >/dev/null
    ok "Swapfile created ($SWAP_SIZE, swappiness 10)"
  else
    info "No swap configured"
  fi

  # ---- 8/9 disk resize ----
  STEP="disk resize"
  echo; info "=== 8/9 Disk resize ==="
  if [[ $RESIZE_ENABLE == y ]]; then
    local root_fs root_type part disk
    root_fs=$(findmnt -no SOURCE /)
    root_type=$(findmnt -no FSTYPE /)
    if [[ $root_fs == /dev/mapper/* ]]; then
      part=$(lsblk -no PKNAME "$root_fs" | head -1 || true)
      [[ -z $part ]] && part=$(pvs --noheadings -o pv_name 2>/dev/null | awk 'NR==1{print $1}' | sed 's#^/dev/##' || true)
    else
      part=${root_fs#/dev/}
    fi
    disk=$(lsblk -no PKNAME "/dev/$part" 2>/dev/null | head -1 || true)
    if [[ -z $disk || -z $part ]]; then
      warn "Could not determine the disk layout, skipping resize"
    elif (( $(lsblk -bno SIZE "/dev/$part") < $(lsblk -bno SIZE "/dev/$disk") )); then
      local pnum suffix
      command -v growpart >/dev/null 2>&1 || \
        apt-get install -y -q cloud-guest-utils >/dev/null 2>&1 || true
      if command -v growpart >/dev/null 2>&1; then
        suffix=${part##*/}; suffix=${suffix#"$disk"}; pnum=${suffix//[^0-9]/}
        if printf 'y\n' | growpart "/dev/$disk" "$pnum" >/dev/null 2>&1; then
          if [[ $root_fs == /dev/mapper/* ]]; then
            command -v pvresize >/dev/null 2>&1 && {
              pvresize "/dev/$part" >/dev/null || warn "pvresize failed"
              lvextend -l +100%FREE "$root_fs" >/dev/null || warn "lvextend failed"
            }
          fi
          if [[ $root_type == xfs ]]; then
            xfs_growfs / >/dev/null || warn "xfs_growfs failed"
          elif [[ $root_type == ext2 || $root_type == ext3 || $root_type == ext4 ]]; then
            resize2fs "$root_fs" >/dev/null || warn "resize2fs failed"
          else
            warn "No online resize for $root_type, skipping"
          fi
          ok "Filesystem grown to $(df -h / | awk 'NR==2{print $2}')"
        else
          warn "growpart failed for /dev/$disk partition $pnum, resize skipped"
        fi
      else
        warn "growpart unavailable, skipping resize"
      fi
    else
      info "Filesystem already uses the full disk"
    fi
  else
    info "Disk resize skipped"
  fi

  # ---- 9/9 cleanup ----
  STEP="cleanup"
  echo; info "=== 9/9 Cleanup ==="
  if [[ $PURGE_CI == y ]]; then
    DEBIAN_FRONTEND=noninteractive apt-get purge -y -q cloud-init >/dev/null || true
    rm -rf /etc/cloud /var/lib/cloud
    rm -f /etc/netplan/50-cloud-init.yaml
    ok "cloud-init removed"
  else
    warn "cloud-init kept: the machine-id changed, so it may re-run at next boot and rewrite netplan/SSH configs. If networking misbehaves, purge cloud-init and re-run vm-init."
  fi
  DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -q >/dev/null || true
  apt-get clean
  cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
  systemctl start apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
  ok "unattended-upgrades enabled (daily timers restarted)"
  journalctl --vacuum-size=50M >/dev/null 2>&1 || true
  find /var/log -type f -name '*.gz' -delete 2>/dev/null || true
  : > /root/.bash_history 2>/dev/null || true
  ok "Cleanup done"

  # ---- summary + apply ----
  STEP="network apply"
  echo
  printf '%s=== Summary ===%s\n' "$BOLD" "$NC"
  printf 'Hostname:  %s\n' "$(hostname)"
  printf 'Interface: %s\n' "$IFACE"
  if [[ $NET_MODE == static ]]; then
    printf 'IP:        %s (gw %s, dns %s)\n' "$STATIC_IP" "$GATEWAY" "$DNS_LIST"
  else
    printf 'IP:        DHCP (reserve by MAC in your router)\n'
  fi
  printf 'Timezone:  %s\n' "$(timedatectl show -p Timezone --value)"
  if command -v ufw >/dev/null 2>&1; then
    printf 'Firewall:  %s\n' "$(ufw status | head -1)"
  else
    printf 'Firewall:  disabled\n'
  fi
  swapon --show | grep -q . \
    && printf 'Swap:      %s\n' "$(swapon --show | awk 'NR==2{print $1" ("$2")"}')" \
    || printf 'Swap:      none\n'
  printf 'MOTD:      installed\n'

  echo
  if [[ $NET_MODE == static ]]; then
    warn "Applying static IP: the SSH connection will drop and return on $STATIC_IP"
    if [[ $REBOOT_NOW == y ]]; then
      systemd-run --on-active=5 reboot >/dev/null 2>&1 || die "Could not schedule reboot via systemd-run"
      info "Reboot scheduled in 5 seconds"
    fi
    info "Applying network config ..."
    netplan apply
    echo
    ok "Done. Reconnect to $STATIC_IP (or use the Proxmox console)."
    [[ $REBOOT_NOW == y ]] || info "Reboot when ready: sudo reboot"
  else
    netplan apply
    if [[ $REBOOT_NOW == y ]]; then
      reboot
    fi
    ok "Done. Re-run anytime: sudo vm-init"
  fi
}

# ---- main ---------------------------------------------------------------

main() {
  [[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

  STEP="preflight"
  clear 2>/dev/null || true
  banner
  warn "Run this on a fresh clone. Existing hostname, netplan and SSH settings will be changed."
  . /etc/os-release
  if [[ ${ID:-} != ubuntu || ${VERSION_ID:-} != 24.04 ]]; then
    warn "Targets Ubuntu 24.04, this is ${PRETTY_NAME:-unknown}. Continuing anyway."
  fi
  if ! ping -c1 -W2 archive.ubuntu.com >/dev/null 2>&1; then
    warn "No network connectivity. If the clone has a stale IP this is expected; apt steps will fail loudly and can be re-run."
  fi

  STEP="collect"
  collect
  show_plan

  if confirm "Execute the plan now" y; then
    STEP="execute"
    clear 2>/dev/null || true
    execute
  else
    warn "Aborted. No changes were made. Run again with: sudo vm-init"
    exit 0
  fi
}

main "$@"
